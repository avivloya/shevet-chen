rules_version = '2';
// Who can read and write what. Paste this into Firebase > Firestore > Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownerDoc() { return /databases/$(database)/documents/settings/owner; }
    function isOwner() { return signedIn() && exists(ownerDoc()) && get(ownerDoc()).data.uid == request.auth.uid; }
    function approved() {
      let a = /databases/$(database)/documents/approvals/$(request.auth.uid);
      return signedIn() && exists(a) && get(a).data.status == 'approved' && get(a).data.portal == 'shachbag';
    }
    function member() { return isOwner() || approved(); }
    function merakez() {
      let a = /databases/$(database)/documents/approvals/$(request.auth.uid);
      return approved() && get(a).data.role in ['mifalim', 'tzeirim', 'bogeret', 'boger'];
    }
    function manager() { return isOwner() || merakez(); }
    function self(uid) { return signedIn() && request.auth.uid == uid; }

    // The first person to sign in after setup becomes the owner (Aviv).
    match /settings/owner {
      allow read: if signedIn();
      allow create: if signedIn() && !exists(ownerDoc()) && request.resource.data.uid == request.auth.uid;
    }
    // Access settings and Cheny notes: members read, only the owner changes.
    match /settings/{id} {
      allow read: if member();
      allow write: if isOwner();
    }
    // The owner and the merakzim approve and remove people (not themselves). Everyone can see their own status.
    match /approvals/{uid} {
      allow read: if member() || self(uid);
      allow write: if manager() && !self(uid);
    }
    // Join requests: your own, or the owner sees all.
    match /requests/{uid} {
      allow read: if manager() || self(uid);
      allow write: if isOwner() || self(uid);
    }
    // Usernames and profile pictures.
    // A profile's username must be claimed in /usernames by the same person,
    // and an approved person can change it only once every 15 days.
    function profileOk() {
      let d = request.resource.data;
      let k = /databases/$(database)/documents/usernames/$(d.username.lower());
      return exists(k) && get(k).data.uid == request.auth.uid && (
        resource == null || resource.data.get('username', '') == ''
        || (resource.data.username == d.username && d.get('nameChangedAt', 0) == resource.data.get('nameChangedAt', 0))
        || (resource.data.username != d.username && d.get('nameChangedAt', 0) > request.time.toMillis() - 600000
            && (!approved() || request.time.toMillis() >= resource.data.get('nameChangedAt', 0) + 1296000000)));
    }
    match /profiles/{uid} {
      allow read: if member() || self(uid);
      allow write: if isOwner() || (self(uid) && profileOk());
    }
    // One username per person: the first to claim a name keeps it.
    match /usernames/{key} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if isOwner() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    match /users/{uid} {
      allow read: if member() || self(uid);
      allow write: if isOwner() || self(uid);
    }
    // Staff attendance: only the owner and the merakzim.
    match /attendance/{id} {
      allow read, write: if manager();
    }
    // Everything else (roster, calendar, messages, machsan, peulot...):
    // only approved shachbag members and the owner.
    match /{col}/{id} {
      allow read, write: if member() && !(col in ['settings', 'approvals', 'requests', 'profiles', 'users', 'attendance', 'usernames']);
    }
  }
}
